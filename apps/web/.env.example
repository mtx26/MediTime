# Copier vers .env et renseigner. Ne jamais committer le .env réel.
# Sur Vercel, ces variables se définissent dans le dashboard du projet :
# les fichiers .env ne sont pas versionnés et donc absents du build.
#
# Rappel : tout ce qui est préfixé VITE_ est inliné dans le bundle et donc
# public. N'y placer aucun secret serveur.

# --- API backend -------------------------------------------------------
VITE_API_URL=http://localhost:5000

# URL publique du site, utilisée pour les métadonnées SEO et les liens canoniques.
VITE_VITE_URL=https://meditime-app.com

VITE_NODE_ENV=development

# Active l'envoi des logs applicatifs vers le backend ("true" pour activer).
VITE_ENABLE_REMOTE_LOGGING=false

# --- Supabase ----------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Firebase ----------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FCM_VAPID_KEY=

# --- Google ------------------------------------------------------------
VITE_GOOGLE_TRANSLATE_API_KEY=

# --- Apple / universal links -------------------------------------------
# Requis pour générer public/.well-known/apple-app-site-association.
# En build de production, le build échoue si cette variable est absente :
# sans elle les universal links iOS seraient inertes sans erreur visible.
VITE_APPLE_TEAM_ID=
# Optionnel, défaut : app.meditime.mobile
IOS_BUNDLE_ID=app.meditime.mobile
