# Copier vers .env et renseigner. Ne jamais committer le .env réel.

# --- Environnement -----------------------------------------------------
# production | development | ci
# En production : la validation de config échoue au démarrage si une variable
# requise manque, et les origines CORS localhost sont refusées.
ENVIRONMENT=development

# --- Supabase Postgres (psycopg2) --------------------------------------
SUPABASE_DB_HOST=
SUPABASE_DB_NAME=
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
# 6543 = pooler en transaction mode, 5432 = session mode
SUPABASE_DB_PORT=6543

# Taille du pool PAR worker gunicorn.
# Total = DB_POOL_MAX_CONN x (workers API + process scheduler).
DB_POOL_MIN_CONN=1
DB_POOL_MAX_CONN=5

# --- Application de la RLS ---------------------------------------------
# Rôles Postgres vers lesquels le backend bascule (SET LOCAL ROLE) pour que les
# policies s'appliquent. L'utilisateur de connexion étant propriétaire des
# tables, sans cette bascule la RLS est contournée.
# Prérequis : appliquer dumps/force_rls_migration.sql.
# Laisser vide désactive la bascule (RLS non appliquée) — dépannage uniquement.
DB_RLS_AUTHENTICATED_ROLE=authenticated
DB_RLS_ANON_ROLE=anon

# --- Supabase Auth (vérification des JWT) ------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Durée de mise en cache d'un jeton validé, en secondes (0 = désactivé).
# Évite un aller-retour HTTP vers Supabase Auth à chaque requête.
AUTH_TOKEN_CACHE_TTL=30
AUTH_TOKEN_CACHE_MAX_SIZE=2048

# --- Google / Firebase / Vertex ----------------------------------------
# Chemin vers le fichier de credentials, ou le JSON du service account inline.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL_ID=gemini-2.5-flash

# --- Cloudinary --------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Frontend et CORS --------------------------------------------------
# Origine principale du frontend, automatiquement autorisée en CORS.
FRONTEND_URL=https://meditime-app.com
# Origines supplémentaires, séparées par des virgules (optionnel).
CORS_ALLOWED_ORIGINS=

# --- Divers ------------------------------------------------------------
SYSTEM_UID=

# --- Email (Resend) ----------------------------------------------------
RESEND_API=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=MediTime
NOTIFICATION_EMAIL_ADDRESS=

# --- SMS (Twilio) ------------------------------------------------------
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_MESSAGING_SERVICE_SID=

# --- Gunicorn (optionnel) ----------------------------------------------
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
PORT=5000
